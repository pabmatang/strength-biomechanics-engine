# Copy this file to `.env` (docker compose reads it automatically) and adjust the values.
# Never commit the real `.env`: it is already in .gitignore.

# PostgreSQL
POSTGRES_DB=mia_fitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port for local tooling. 5433 avoids clashing with a local PostgreSQL.
POSTGRES_PORT=5433

# JWT: must be at least 32 bytes (256 bits). Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=cambia-esto-por-un-secreto-de-al-menos-32-bytes

# Browser origins allowed to call the API directly (Vite dev server / nginx).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Ollama models (must be pulled into the ollama container).
OLLAMA_CHAT_MODEL=llama3.2-vision
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Host port for the Ollama API (change it if you already run Ollama locally).
OLLAMA_PORT=11434

# Seed the biomechanical knowledge base and generate embeddings on boot.
SEED_KNOWLEDGE_BASE=true
